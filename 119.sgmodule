[Script]
SM-119-01 = type=http-response,pattern=^https?://www\.ssalegs\.store/cms/Appapi/username/username/\d+,requires-body=true,script-path=https://raw.githubusercontent.com/lutqhysky/quantumultx/mylove/SSA/Script/SSA.js,script-update-interval=0

[MITM]
hostname = %APPEND% www.ssalegs.store
