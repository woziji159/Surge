[URL Rewrite]
^https:\/\/api\.sevenworkouts\.com\/api\/v1\/account\/subscription-purchases _ reject
^https:\/\/api\.sevenworkouts\.com\/api\/v1\/buyers\/ _ reject

[Script]
SM-197-08 = type=http-response,pattern=^https:\/\/api\.sevenworkouts\.com\/api\/v(\d)\/(verify-purchases|account/verify-purchases),requires-body=true,script-path=https://raw.githubusercontent.com/89996462/Quantumult-X/main/ycdz/Seven.js

[MITM]
hostname = %APPEND% api.sevenworkouts.com
