#!name=Anh Tu - Surge 精简兼容版
#!desc=保留非 YouTube 应用规则与远程脚本；移除全局分流，避免覆盖主配置。
#!version=3.2.6-apex
#!date=2026-10-30
#!author=Nguyễn Ngọc Anh Tú
#!homepage=https://github.com/K4Z3X0R/NguyenNgocAnhTu
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple.png
# Derived from https://raw.githubusercontent.com/K4Z3X0R/NguyenNgocAnhTu/master/Module/NguyenNgocAnhTu_Surge.sgmodule
# Local filter: YouTube and global routing removed; scoped app transport rules retained.

[General]
force-http-engine-hosts = %APPEND% api.revenuecat.com:443, api.rc-backup.com:443, buy.itunes.apple.com:443, api.locketcamera.com:443, *.locketcamera.com:443, us-central1-locket-4252a.cloudfunctions.net:443, sub.store:443, com.zijayrate.analogcam:443, api.elsaspeak.com:443, api.photoroom.com:443, api.remini.ai:443, api.bazaart.me, firebaseremoteconfig.googleapis.com:443

[Rule]
AND,((DOMAIN,firebaseremoteconfig.googleapis.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,locketcamera.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,us-central1-locket-4252a.cloudfunctions.net), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.rc-backup.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,buy.itunes.apple.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,sub.store), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN-KEYWORD,spotify), (PROTOCOL,UDP)),REJECT
DOMAIN-SUFFIX,audio-fa.scdn.co,REJECT
DOMAIN-KEYWORD,spotify-ads,REJECT
DOMAIN-SUFFIX,ads-fa.spotify.com,REJECT
DOMAIN-SUFFIX,analytics.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,log.spotify.com,REJECT
DOMAIN-SUFFIX,creativeservice-production.scdn.co,REJECT
DOMAIN-SUFFIX,gads.current.spotify.com,REJECT
DOMAIN,audio-sp-sto.pscdn.co,REJECT
DOMAIN,audio-sp-ash.pscdn.co,REJECT
DOMAIN,audio-sp-dca.pscdn.co,REJECT
DOMAIN,audio-sp-lon.pscdn.co,REJECT
DOMAIN,podcastads.spotify.com,REJECT

[Script]
Sub-Store Core=type=http-request,pattern=^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))),script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-1.min.js,requires-body=true,timeout=120
Sub-Store Simple=type=http-request,pattern=^https?:\/\/sub\.store,script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-0.min.js,requires-body=true
Sub-Store Sync=type=cron,cronexp=0 0 * * *,wake-system=1,timeout=120,script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/cron-sync-artifacts.min.js
sp-json=type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://raw.githubusercontent.com/app2smile/rules/df6366a7024e0b3f0aa3510c5b791eea6f3cba89/js/spotify-json.js
sp-proto=type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/app2smile/rules/df6366a7024e0b3f0aa3510c5b791eea6f3cba89/js/spotify-proto.js,script-update-interval=0
Spotify_Premium=type=http-response,pattern=^https?:\/\/(api\.spotify\.com\/v1\/me|.*spclient.*\.spotify\.com(:443)?\/(identity\/v3\/me|device-capabilities\/v1\/capabilities|user-attributes\/v\d+\/attributes|bootstrap\/v1\/bootstrap|melody\/v1\/check_license)),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/K4Z3X0R/NguyenNgocAnhTu/master/Module/js/spotify.js?v=2.9.5,script-update-interval=0
rc-res=type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),script-path=https://raw.githubusercontent.com/K4Z3X0R/NguyenNgocAnhTu/master/Module/js/revenuecat_multi.js?v=3.2.5,requires-body=true,max-size=-1,timeout=60
rc-backup=type=http-response,pattern=^https:\/\/api\.rc-backup\.com\/.+\/(receipts$|subscribers\/[^/]+$),script-path=https://raw.githubusercontent.com/K4Z3X0R/NguyenNgocAnhTu/master/Module/js/revenuecat_multi.js?v=3.2.5,requires-body=true,max-size=-1,timeout=60
locket-30s-req=type=http-request,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/.*,script-path=https://raw.githubusercontent.com/K4Z3X0R/NguyenNgocAnhTu/master/Module/js/Locket_30s.js?v=3.2.5,timeout=60
