#!name=Google 综合增强（原生翻页修复）
#!desc=繁体中文翻页兼容、提前加载、Google页面加载优化；保留毒奶净化。
[Script]
Google 综合增强 = type=http-response, pattern=^https://www[.]google[.][a-z.]+/(?:search[?]|[?](?:sa|FORM)=|$), requires-body=true, max-size=-1, timeout=10, engine=auto, script-path=https://raw.githubusercontent.com/woziji159/Surge/main/ext-google-combined-response.js?v=20261014-native-zhfix3
